{
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost\\SQLEXPRESS08;Database=SankoImece;Trusted_Connection=True;TrustServerCertificate=True;"
    },

    "Database": {
        "Profile": "LocalIntegrated",
        "Server": "localhost",
        "Instance": "SQLEXPRESS08",
        "DatabaseName": "SankoImece",
        "CreateIfMissing": true,
        "Encrypt": true,
        "TrustServerCertificate": true,
        "ConnectTimeoutSeconds": 30,
        "CommandTimeoutSeconds": 60
    },

    "DatabaseSchema": {
        "Enabled": false,
        "CreateDatabaseIfMissing": true,
        "AllowDestructiveChanges": false,
        "FailApplicationOnError": true,
        "CommandTimeoutSeconds": 120,
        "LockTimeoutSeconds": 60,
        "LogGeneratedSql": false,
        "SeedDevelopmentData": false
    },

    "FileStorage": {
        "MaxFileSizeBytes": 26214400
    },

    "//ContentIsolation": "Enforce=true YALNIZCA schema sync + backfill tamamlandıktan sonra açılmalıdır.",
    "ContentIsolation": {
        "Enforce": false
    },

    "//ContentScopeBackfill": "Güvenli varsayılan: kapalı + dry-run. Gerçek atama için DryRun=false ve DefaultCompanyCode verilmelidir.",
    "ContentScopeBackfill": {
        "Enabled": false,
        "DefaultCompanyCode": null,
        "FailOnUnassignedContent": true,
        "DryRun": true,
        "BatchSize": 500
    },

    "//Audit": "Otomatik request/mutation/error audit. Schema sync audit_log kolonlarını ekler.",
    "Audit": {
        "Enabled": false,
        "ContentFailureMode": "FailOpen",
        "CaptureHttpRequests": true,
        "CaptureMutations": true,
        "CaptureErrors": true,
        "CaptureSqlWrites": false,
        "CaptureFailedResults": true,
        "UseBackgroundQueue": true,
        "MaxBodyBytes": 8192,
        "QueueCapacity": 2048,
        "ExcludedPathPrefixes": [ "/health", "/swagger" ]
    },

    "ClientApplication": {
        "HeaderName": "X-Client-Application",
        "AllowedValues": [ "Web", "AdminPanel" ],
        "DefaultForRequests": "Web",
        "SystemValue": "System"
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "ExceptionHandling": {
        "IncludeExceptionDetailsInDevelopment": false,
        "IncludeTraceId": true,
        "LogValidationErrors": false
    },

    "Authentication": {
        "Mode": "Development"
    },

    "AllowedHosts": "*"
}